MAIL_HOSTNAME=mail.adam.uz
MAIL_PUBLIC_URL=https://mail.adam.uz

# For a pilot, use temporary DNS names here and in Caddyfile; production values stay above.
# Bootstrap only: generate with `openssl rand -base64 32` and remove after setup.
STALWART_RECOVERY_ADMIN=admin:replace-with-a-long-random-password

# Bulwark encrypts sessions and synchronized settings with this secret.
# Generate with: openssl rand -base64 32
BULWARK_SESSION_SECRET=replace-with-a-different-long-random-secret
